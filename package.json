{
  "name": "dfc-companion-play-system",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @dfc/database prisma:generate",
    "db:migrate": "pnpm --filter @dfc/database prisma:migrate",
    "db:deploy": "pnpm --filter @dfc/database prisma:deploy",
    "seed:admin": "pnpm --filter @dfc/database seed:admin",
    "test:business": "node scripts/test-business.cjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.10.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "2.5.0",
      "undici@>=6 <6.29.1": "6.29.1",
      "proxy-addr@<2.0.8": "2.0.8",
      "body-parser@>=1 <1.20.9": "1.20.9",
      "postcss@<8.5.31": "8.5.31",
      "nanoid@>=3 <3.3.20": "3.3.20",
      "source-map-js@<1.2.2": "1.2.2",
      "glob@>=10 <10.5.0": "10.5.0",
      "picomatch@>=4 <4.0.4": "4.0.4",
      "brace-expansion@>=1 <1.1.20": "1.1.20",
      "brace-expansion@>=2 <2.1.6": "2.1.6",
      "js-yaml@>=3 <3.15.2": "3.15.2",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "fast-uri@>=3 <3.1.7": "3.1.7",
      "browserslist@<4.28.7": "4.28.7",
      "handlebars@<4.7.10": "4.7.10",
      "tmp@<0.2.7": "0.2.7"
    }
  }
}
